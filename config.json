{
  "main": {
    "description": "Standard-Agent, gestartet mit `cl` ohne Argument.",
    "contexts": ["main"],
    "model": "sonnet"
  },
  "agents": [
    {
      "name": "dev",
      "description": "Standard-Entwickler für alltägliche Entwicklungsaufgaben.",
      "contexts": ["main", "dev/code", "dev/deny-gradle"],
      "model": "sonnet"
    },
    {
      "name": "remote",
      "description": "Standard-Entwickler für alltägliche Entwicklungsaufgaben.",
      "contexts": ["main", "dev/code", "dev/deny-gradle", "dev/remote"],
      "model": "sonnet"
    },
    {
      "name": "ut",
      "description": "Wie dev, darf aber zusätzlich Gradle-Befehle ausführen.",
      "contexts": ["main", "dev/code", "dev/allow-gradle"],
      "model": "sonnet",
      "permissions": ["Bash(gradle *)", "Bash(./gradlew *)", "Bash(gradlew *)"]
    }
  ],
  "databaseDirectory": "/home/sklein/commands",
  "paths": [
    {
      "name": "claude-cli",
      "path": "/home/sklein/IdeaProjects/claude-cli",
      "hosted": [
        { "name": "config", "path": "config.json", "type": "file" },
        { "name": "project", "path": ".", "type": "path" }
      ]
    },
    {
      "name": "periodical",
      "path": "/home/sklein/IdeaProjects/periodical",
      "hosted": [
        {
          "name": "debug-apk",
          "path": "app/build/outputs/apk/debug/app-debug.apk",
          "type": "file"
        },
        {
          "name": "release-apk",
          "path": "app/build/outputs/apk/release/allinonecalendar.apk",
          "type": "file"
        }
      ],
      "hooks": {
        "onLastAgentFinish": "cl inst"
      }
    },
    {
      "name": "chordutil",
      "path": "/home/sklein/IdeaProjects/chordutil",
      "hosted": [
        {
          "name": "debug-apk",
          "path": "app/build/outputs/apk/debug/app-debug.apk",
          "type": "file"
        },
        {
          "name": "release-apk",
          "path": "app/build/outputs/apk/release/chordutil.apk",
          "type": "file"
        }
      ],
      "hooks": {
        "onLastAgentFinish": "cl inst"
      }
    },
    {
      "name": "gardener",
      "path": "/home/sklein/IdeaProjects/gardener",
      "hosted": [
        {
          "name": "debug-apk",
          "path": "app/build/outputs/apk/debug/app-debug.apk",
          "type": "file"
        },
        {
          "name": "release-apk",
          "path": "app/build/outputs/apk/release/gardener.apk",
          "type": "file"
        }
      ],
      "hooks": {
        "onLastAgentFinish": "cl inst"
      }
    },
    {
      "name": "base-project",
      "path": "/home/sklein/IdeaProjects/base-project",
      "hosted": [
        {
          "name": "debug-apk",
          "path": "app/build/outputs/apk/debug/app-debug.apk",
          "type": "file"
        },
        {
          "name": "release-apk",
          "path": "app/build/outputs/apk/release/base-project.apk",
          "type": "file"
        }
      ],
      "hooks": {
        "onLastAgentFinish": "cl inst"
      }
    },
    {
      "name": "therapy",
      "path": "/home/sklein/IdeaProjects/therapy",
      "hosted": [
        {
          "name": "debug-apk",
          "path": "app/build/outputs/apk/debug/app-debug.apk",
          "type": "file"
        },
        {
          "name": "release-apk",
          "path": "app/build/outputs/apk/release/therapyfinder.apk",
          "type": "file"
        }
      ],
      "hooks": {
        "onLastAgentFinish": "cl inst"
      }
    },
    {
      "name": "carfinder",
      "path": "/home/sklein/IdeaProjects/carfinder",
      "hosted": [
        {
          "name": "debug-apk",
          "path": "app/build/outputs/apk/debug/app-debug.apk",
          "type": "file"
        },
        {
          "name": "release-apk",
          "path": "app/build/outputs/apk/release/carfinder.apk",
          "type": "file"
        }
      ],
      "hooks": {
        "onLastAgentFinish": "cl inst"
      }
    },
    {
      "name": "commander",
      "path": "/home/sklein/IdeaProjects/claude-cli/commander",
      "hosted": [
        {
          "name": "debug-apk",
          "path": "app/build/outputs/apk/debug/app-debug.apk",
          "type": "file"
        },
        {
          "name": "release-apk",
          "path": "app/build/outputs/apk/release/commander.apk",
          "type": "file"
        }
      ]
    },
    {
      "name": "app-getter",
      "path": "/home/sklein/IdeaProjects/claude-cli/app-getter",
      "hosted": [
        {
          "name": "debug-apk",
          "path": "app/build/outputs/apk/debug/app-debug.apk",
          "type": "file"
        },
        {
          "name": "release-apk",
          "path": "app/build/outputs/apk/release/app-getter.apk",
          "type": "file"
        }
      ]
    }
  ],
  "defaultCommands": [
    {
      "key": "clean",
      "command": "./gradlew clean",
      "displayName": "Clean",
      "description": "Raeumt alle Build-Artefakte auf."
    },
    {
      "key": "assemble-debug",
      "command": "./gradlew assembleDebug",
      "displayName": "Build Debug",
      "description": "Baut die Debug-APK."
    },
    {
      "key": "assemble-release",
      "command": "./gradlew assembleRelease",
      "displayName": "Build Release",
      "description": "Baut die Release-APK."
    },
    {
      "key": "commit",
      "command": "git add . && git commit -m 'remote update code commit' && git push",
      "displayName": "Commit and Push",
      "description": "Macht ein git commit mit allen changes und pusht."
    },
    {
      "key": "status",
      "command": "git status",
      "displayName": "Status",
      "description": "Zeigt den aktuellen git-Status."
    },
    {
      "key": "update",
      "command": "git merge master",
      "displayName": "merge-master",
      "description": "Merged den master in diesen branch."
    },
    {
      "key": "install-debug",
      "command": "cl inst",
      "displayName": "Build Debug + Install",
      "description": "Baut die Debug-APK per Gradle und installiert sie auf allen verbundenen adb-Geraeten."
    },
    {
      "key": "install-release",
      "command": "cl instr",
      "displayName": "Build Release + Install",
      "description": "Baut die Release-APK per Gradle und installiert sie auf allen verbundenen adb-Geraeten."
    }
  ],
  "tasks": [
    {
      "name": "review-local",
      "description": "Macht ein review für alle local changes.",
      "contexts": ["main"],
      "model": "sonnet",
      "startCommand": "Mache ein review für alle git local changes. Falls es keine gibt, nimm einfach nur den letzten commit. Prüfe dabei auf verwendung der richtigen versionen, ausschließliche Verwendung von legal kostenlos kommerziell nutzbaren inhalten, verletzung von copyrights, und vor allem sauberen code: Best practices, Clean-Code, gute software architektur, saubere integration in die gesamte und bugs sowie die richtige funktionierende Umsetzung der Features und dass sie zu den neuen Changelog-Einträgen passen. Wenn du findings hast, behebe sie direkt.",
      "permissions": ["Bash(gradle *)", "Bash(./gradlew *)", "Bash(gradlew *)"]
    }
  ],
  "schedulers": [
    {
      "name": "security-audit-0000",
      "description": "Daily security audit",
      "cron": "0 0 * * *",
      "paths": ["periodical"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    },
    {
      "name": "legal-review-0030",
      "description": "Daily legal review",
      "cron": "30 0 * * *",
      "paths": ["periodical"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    },
    {
      "name": "app-store-review-0100",
      "description": "Daily App-Store review",
      "cron": "0 1 * * *",
      "paths": ["periodical"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    },
    {
      "name": "architecture-review-0130",
      "description": "Daily architecture review",
      "cron": "30 1 * * *",
      "paths": ["periodical"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    },
    {
      "name": "inconsistency-check-0200",
      "description": "Daily inconsistency check",
      "cron": "0 2 * * *",
      "paths": ["periodical"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    },
    {
      "name": "suggestion-check-0230",
      "description": "3-Daily suggestion check",
      "cron": "30 2 * * 5,1",
      "paths": ["periodical"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    },
    {
      "name": "todo-cleanup-0300",
      "description": "Daily todo.md cleanup",
      "cron": "0 3 * * *",
      "paths": ["periodical"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    },
    {
      "name": "local-changes-review-0330",
      "description": "Daily local-changes review",
      "cron": "30 3 * * *",
      "paths": ["periodical"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    },
    {
      "name": "code-review-0500",
      "description": "Daily Code-Review",
      "cron": "0 5 * * *",
      "paths": ["periodical"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    },
    {
      "name": "periodical-referenzen-entferner-1000",
      "description": "Daily periodical-referenzen Entferner",
      "cron": "0 10 * * *",
      "paths": ["periodical"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    },
    {
      "name": "cli-endpunkte-1500",
      "description": "Aufgaben zu den neuen CLI-Endpunkten, Lauf um 15 Uhr.",
      "cron": "0 15 * * *",
      "paths": ["periodical"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    },
    {
      "name": "code-review-0505",
      "description": "Daily Code-Review",
      "cron": "5 5 * * *",
      "paths": ["chordutil", "gardener", "carfinder"],
      "model": "sonnet",
      "contexts": ["main", "dev/code"]
    }
  ],
  "ticketAgent": {
    "model": "haiku",
    "task": "Du bekommst einen kurzen, oft unklaren Text zu einem Software-Projekt. Untersuche das Projekt im aktuellen Arbeitsverzeichnis (Dateien, README, CLAUDE.md, context.md, Code, Architektur), um zu verstehen, was der Text im Kontext dieses Projekts bedeuten könnte. Erstelle daraus ein extrem kurz gehaltenes Ticket."
  },
  "contentPath": "/home/sklein/collected",
  "collection": [
    {
      "sourcePath": "/home/sklein/IdeaProjects/periodical/app/build/outputs/apk/debug/app-debug.apk",
      "targetName": "allinonecalendar",
      "path": "periodical"
    },
    {
      "sourcePath": "/home/sklein/IdeaProjects/chordutil/app/build/outputs/apk/debug/app-debug.apk",
      "targetName": "chordutil",
      "path": "chordutil"
    },
    {
      "sourcePath": "/home/sklein/IdeaProjects/gardener/app/build/outputs/apk/debug/app-debug.apk",
      "targetName": "gardener",
      "path": "gardener"
    },
    {
      "sourcePath": "/home/sklein/IdeaProjects/base-project/app/build/outputs/apk/debug/app-debug.apk",
      "targetName": "base-project",
      "path": "base-project"
    }
  ]
}
