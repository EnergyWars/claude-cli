{
  "openapi": "3.1.0",
  "info": {
    "title": "cl server API",
    "description": "HTTP-API von `cl server`. Exposed alle in config.json definierten Agents als headless POST-Endpunkte und liefert Status/Output ueber GET /state/{id}. Alle Endpunkte ausser POST /auth/setup und POST /auth/setup/confirm verlangen einen gueltigen Google-Authenticator-Code im Header X-TOTP-Code; die beiden Setup-Endpunkte sind nur aus dem lokalen Netz erreichbar (sonst 404) und liefern 409, sobald ein Authenticator aktiv ist. Ein aktiver Authenticator kann ausschliesslich per CLI (`cl totp remove`) entfernt werden, nicht ueber die HTTP-API.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "Default (Port ueberschreibbar via `cl server --port`)"
    }
  ],
  "security": [{ "TotpAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Erreichbarkeits-Check, kein Auth noetig",
        "description": "Kein X-TOTP-Code noetig und keine Lokalnetz-Beschraenkung - gibt nichts Sensibles preis (ein laufender cl server ist ueber 401 auf jeder geschuetzten Route ohnehin schon erkennbar). Gedacht, damit ein Client 'Host erreichbar?' unabhaengig vom TOTP-Pairing-Status pruefen kann.",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Server laeuft.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "Leere 204-Antwort, kein Auth noetig, fuer Auto-Discovery",
        "description": "Kein X-TOTP-Code noetig und keine Lokalnetz-Beschraenkung. Antwortet immer mit 204 und leerem Body - gedacht, damit ein Client beim Scannen des lokalen /24-Subnetzes pro Adresse moeglichst schnell und ohne JSON-Parsing feststellen kann, ob dort ein cl server laeuft.",
        "operationId": "getStatus",
        "security": [],
        "responses": {
          "204": {
            "description": "Server laeuft."
          }
        }
      }
    },
    "/auth/setup": {
      "post": {
        "summary": "Richtet einen neuen Google Authenticator ein (Schritt 1: Secret generieren)",
        "description": "Nur aus dem lokalen Netz erreichbar (sonst 404). Erzeugt ein neues, unbestaetigtes TOTP-Secret und ersetzt damit ein zuvor unbestaetigtes Secret. Schlaegt fehl, solange bereits ein Authenticator aktiv (bestaetigt) ist - dieser muss zuerst per CLI (`cl totp remove`) entfernt werden.",
        "operationId": "setupAuth",
        "security": [],
        "responses": {
          "200": {
            "description": "Neues, noch unbestaetigtes Secret. Muss per POST /auth/setup/confirm mit einem damit erzeugten Code bestaetigt werden, bevor es aktiv wird.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSetupResponse" }
              }
            }
          },
          "404": {
            "description": "Zugriff nicht aus dem lokalen Netz.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "Es ist bereits ein Google Authenticator aktiv.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "summary": "Liefert den aktuellen TOTP-Einrichtungsstatus",
        "description": "Nur aus dem lokalen Netz erreichbar (sonst 404). Erlaubt einem Client, vor dem ersten POST /auth/setup zwischen 'nichts eingerichtet', 'Setup ausstehend/unbestaetigt' und 'Authenticator aktiv' zu unterscheiden, ohne sich allein auf den 409-Statuscode von POST /auth/setup verlassen zu muessen. Enthaelt niemals das Secret selbst.",
        "operationId": "getAuthStatus",
        "security": [],
        "responses": {
          "200": {
            "description": "Aktueller Einrichtungsstatus.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthStatusResponse" }
              }
            }
          },
          "404": {
            "description": "Zugriff nicht aus dem lokalen Netz.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/auth/setup/confirm": {
      "post": {
        "summary": "Bestaetigt das per POST /auth/setup erzeugte Secret (Schritt 2: aktivieren)",
        "description": "Nur aus dem lokalen Netz erreichbar (sonst 404). Aktiviert das ausstehende Secret, sofern der uebergebene Code dazu passt.",
        "operationId": "confirmAuthSetup",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthSetupConfirmRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticator aktiviert.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } }
            }
          },
          "400": {
            "description": "Body ungueltig (kein JSON, oder Feld \"code\" fehlt/leer), oder kein ausstehendes Setup vorhanden.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Der uebergebene Code passt nicht zum ausstehenden Secret.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Zugriff nicht aus dem lokalen Netz.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "409": {
            "description": "Es ist bereits ein Google Authenticator aktiv.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/": {
      "post": {
        "summary": "Startet einen headless Command auf dem main-Agent",
        "operationId": "runMainAgentCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CommandRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Command wurde gestartet, laeuft im Hintergrund weiter.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommandAccepted" }
              }
            }
          },
          "400": {
            "description": "Body ungueltig (kein JSON, oder Feld \"command\"/\"path\" fehlt/leer).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Eintrag mit diesem Namen in config.json (paths[].name).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": {
            "description": "Unerwarteter Serverfehler.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/{agent}": {
      "post": {
        "summary": "Startet einen headless Command auf einem benannten Agent",
        "operationId": "runNamedAgentCommand",
        "parameters": [
          {
            "name": "agent",
            "in": "path",
            "required": true,
            "description": "Name eines Agents aus config.json (agents[].name).",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CommandRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Command wurde gestartet, laeuft im Hintergrund weiter.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommandAccepted" }
              }
            }
          },
          "400": {
            "description": "Body ungueltig (kein JSON, oder Feld \"command\"/\"path\" fehlt/leer).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Agent mit diesem Namen in config.json, oder kein Eintrag mit diesem Namen in config.json (paths[].name).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": {
            "description": "Unerwarteter Serverfehler.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/paths": {
      "get": {
        "summary": "Listet die Namen aller konfigurierten Pfade",
        "operationId": "listPaths",
        "responses": {
          "200": {
            "description": "Namen aller Eintraege aus config.json (paths[].name), ohne die zugehoerigen Dateisystem-Pfade.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PathList" }
              }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/manifest": {
      "get": {
        "summary": "Liefert alle Agents und Pfade (inkl. deren Commands/Hosted-Eintraege) in einem Aufruf",
        "description": "Aggregierte Sicht der gesamten in config.json definierten Oberflaeche, gedacht fuer eine remote steuerbare App: Agents (name-lose 'cl'-Befehle mit description) und alle Pfade mit deren konfigurierten Commands (paths[].commands) sowie Hosted-Eintraegen (nur name + type, ohne Dateisystem-Pfade). Tasks sind nicht enthalten - sie sind ausschliesslich per CLI ('cl task <name>', immer interaktiv) nutzbar, niemals ueber die API. Ersetzt keinen der bestehenden Detail-Endpunkte, sondern buendelt deren Daten fuer eine dynamische UI, die ohne Codeaenderung neue Agents/Paths/Commands anzeigen kann.",
        "operationId": "getManifest",
        "responses": {
          "200": {
            "description": "Vollstaendige Uebersicht aller Agents und Pfade.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Manifest" }
              }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/paths/{pathName}/commands": {
      "get": {
        "summary": "Listet die konfigurierten Commands eines Pfads",
        "operationId": "listPathCommands",
        "parameters": [
          {
            "name": "pathName",
            "in": "path",
            "required": true,
            "description": "Name eines Eintrags aus config.json (paths[].name).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Alle Commands (paths[].commands[]) dieses Pfads.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PathCommandList" }
              }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Eintrag mit diesem Namen in config.json (paths[].name).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/paths/{pathName}/commands/{key}": {
      "post": {
        "summary": "Fuehrt einen konfigurierten Command aus",
        "description": "Startet den Command im Dateisystem-Verzeichnis des Pfad-Eintrags (paths[].path) als cwd, headless und im Hintergrund. Antwortet sofort mit 202, Status/Output ueber GET /state/{id}.",
        "operationId": "runPathCommand",
        "parameters": [
          {
            "name": "pathName",
            "in": "path",
            "required": true,
            "description": "Name eines Eintrags aus config.json (paths[].name).",
            "schema": { "type": "string" }
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "Key eines Commands (paths[].commands[].key) dieses Pfads.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "202": {
            "description": "Command wurde gestartet, laeuft im Hintergrund weiter.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommandAccepted" }
              }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Eintrag mit diesem Pfad-Namen, oder kein Command mit diesem Key in diesem Pfad.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/files/{pathName}": {
      "get": {
        "summary": "Listet die Namen aller hosted-Eintraege eines Pfads",
        "operationId": "listHostedNames",
        "parameters": [
          {
            "name": "pathName",
            "in": "path",
            "required": true,
            "description": "Name eines Eintrags aus config.json (paths[].name).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Namen aller hosted-Eintraege (paths[].hosted[].name) dieses Pfads. Deren paths[].hosted[].path ist in config.json relativ zu paths[].path angegeben und wird serverseitig zum absoluten Dateisystem-Pfad aufgeloest.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HostedList" }
              }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Eintrag mit diesem Namen in config.json (paths[].name).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/files/{pathName}/{hostedName}": {
      "get": {
        "summary": "Laedt eine hosted-Datei herunter oder listet den Inhalt eines hosted-Verzeichnisses",
        "operationId": "getHostedEntry",
        "parameters": [
          {
            "name": "pathName",
            "in": "path",
            "required": true,
            "description": "Name eines Eintrags aus config.json (paths[].name).",
            "schema": { "type": "string" }
          },
          {
            "name": "hostedName",
            "in": "path",
            "required": true,
            "description": "Name eines hosted-Eintrags (paths[].hosted[].name) dieses Pfads.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Bei type \"file\": direkter Datei-Download (Content-Type nach Dateiendung, Content-Disposition: attachment). Bei type \"path\": Liste der Dateien direkt in diesem Verzeichnis.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FileList" }
              },
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Eintrag mit diesem Pfad- oder Hosted-Namen, oder die zugehoerige Datei/das Verzeichnis existiert nicht mehr auf der Platte.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/files/{pathName}/{hostedName}/{fileName}": {
      "get": {
        "summary": "Laedt eine einzelne Datei aus einem hosted-Verzeichnis (type \"path\") herunter",
        "operationId": "getHostedFile",
        "parameters": [
          {
            "name": "pathName",
            "in": "path",
            "required": true,
            "description": "Name eines Eintrags aus config.json (paths[].name).",
            "schema": { "type": "string" }
          },
          {
            "name": "hostedName",
            "in": "path",
            "required": true,
            "description": "Name eines hosted-Eintrags (paths[].hosted[].name) vom type \"path\".",
            "schema": { "type": "string" }
          },
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "description": "Name einer Datei direkt im hosted-Verzeichnis (aus der Liste von GET /files/{pathName}/{hostedName}).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Direkter Datei-Download (Content-Type nach Dateiendung, Content-Disposition: attachment).",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "400": {
            "description": "Ungueltiger Dateiname (z. B. Pfad-Traversal-Versuch).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Eintrag mit diesem Pfad- oder Hosted-Namen, der Hosted-Eintrag ist vom type \"file\" statt \"path\", oder die Datei existiert nicht im Verzeichnis.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/state/{id}": {
      "get": {
        "summary": "Status und Output eines Commands abfragen",
        "operationId": "getCommandState",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Von POST / bzw. POST /{agent} zurueckgegebene Command-ID.",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Aktueller Stand des Commands (Output ist waehrend \"running\" bereits teilweise befuellt).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommandState" }
              }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Keine Command mit dieser ID bekannt.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/tickets": {
      "get": {
        "summary": "Listet Tickets ueber alle Pfade hinweg",
        "description": "Ohne Query-Parameter \"status\" werden alle Tickets aller Pfade geliefert (unabhaengig vom Status).",
        "operationId": "listAllTickets",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Optionaler Status-Filter.",
            "schema": { "$ref": "#/components/schemas/TicketStatus" }
          }
        ],
        "responses": {
          "200": {
            "description": "Alle Tickets, ggf. nach Status gefiltert.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TicketList" } }
            }
          },
          "400": {
            "description": "Ungueltiger Wert im Query-Parameter \"status\".",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/tickets/{pathName}": {
      "get": {
        "summary": "Listet Tickets eines Pfads",
        "description": "Ohne Query-Parameter \"status\" werden alle Tickets dieses Pfads geliefert (unabhaengig vom Status).",
        "operationId": "listTickets",
        "parameters": [
          {
            "name": "pathName",
            "in": "path",
            "required": true,
            "description": "Name eines Eintrags aus config.json (paths[].name).",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Optionaler Status-Filter.",
            "schema": { "$ref": "#/components/schemas/TicketStatus" }
          }
        ],
        "responses": {
          "200": {
            "description": "Tickets dieses Pfads, ggf. nach Status gefiltert.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TicketList" } }
            }
          },
          "400": {
            "description": "Ungueltiger Wert im Query-Parameter \"status\".",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Eintrag mit diesem Namen in config.json (paths[].name).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "post": {
        "summary": "Erstellt ein Ticket per Ticket-Agent",
        "description": "\"text\" wird unveraendert als \"originalRequest\" gespeichert. Fuehrt synchron einen Agent aus (Model + Aufgabe aus config.json ticketAgent, siehe TicketAgentConfig) im Dateisystem-Verzeichnis des Pfad-Eintrags: Der Agent interpretiert \"text\" im Projektkontext und liefert summary/claudeInstruction/category fuer ein neues Ticket (Status immer \"open\"). Antwortet erst nach Abschluss des Agents (kein 202/Polling wie bei den Agent-Endpunkten).",
        "operationId": "createTicket",
        "parameters": [
          {
            "name": "pathName",
            "in": "path",
            "required": true,
            "description": "Name eines Eintrags aus config.json (paths[].name).",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TicketCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket wurde angelegt.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Ticket" } }
            }
          },
          "400": {
            "description": "Body ungueltig (kein JSON, oder Feld \"text\" fehlt/leer).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Eintrag mit diesem Namen in config.json (paths[].name).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "502": {
            "description": "Der Ticket-Agent ist fehlgeschlagen oder seine Antwort enthielt kein gueltiges Ticket-JSON.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/tickets/{pathName}/{id}": {
      "get": {
        "summary": "Liefert ein einzelnes Ticket",
        "operationId": "getTicket",
        "parameters": [
          { "$ref": "#/components/parameters/TicketPathName" },
          { "$ref": "#/components/parameters/TicketId" }
        ],
        "responses": {
          "200": {
            "description": "Das Ticket.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Ticket" } }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Eintrag mit diesem Pfad-Namen, oder kein Ticket mit dieser ID in diesem Pfad.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "patch": {
        "summary": "Bearbeitet ein Ticket (alles ausser der ID)",
        "description": "Mindestens eines der Felder originalRequest/summary/claudeInstruction/category/status muss angegeben werden.",
        "operationId": "updateTicket",
        "parameters": [
          { "$ref": "#/components/parameters/TicketPathName" },
          { "$ref": "#/components/parameters/TicketId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TicketUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Das aktualisierte Ticket.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Ticket" } }
            }
          },
          "400": {
            "description": "Body ungueltig (kein JSON, ungueltiger Status, oder kein Feld angegeben).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Eintrag mit diesem Pfad-Namen, oder kein Ticket mit dieser ID in diesem Pfad.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "delete": {
        "summary": "Loescht ein Ticket",
        "operationId": "deleteTicket",
        "parameters": [
          { "$ref": "#/components/parameters/TicketPathName" },
          { "$ref": "#/components/parameters/TicketId" }
        ],
        "responses": {
          "200": {
            "description": "Ticket wurde geloescht.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } }
            }
          },
          "401": {
            "description": "Header X-TOTP-Code fehlt oder ist ungueltig.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Kein Eintrag mit diesem Pfad-Namen, oder kein Ticket mit dieser ID in diesem Pfad.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "TicketPathName": {
        "name": "pathName",
        "in": "path",
        "required": true,
        "description": "Name eines Eintrags aus config.json (paths[].name).",
        "schema": { "type": "string" }
      },
      "TicketId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Fortlaufende, eindeutige Ticket-ID.",
        "schema": { "type": "integer" }
      }
    },
    "schemas": {
      "CommandRequest": {
        "type": "object",
        "required": ["command", "path"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "description": "Der Prompt/Befehl, der headless (claude --print) an den Agent geschickt wird."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Name eines Eintrags aus config.json (paths[].name), bestimmt das Arbeitsverzeichnis (cwd), in dem claude ausgefuehrt wird. Der zugehoerige Dateisystem-Pfad wird serverseitig aus config.json aufgeloest, nicht direkt im Request angegeben."
          },
          "model": {
            "type": "string",
            "description": "Optional. Ueberschreibt das in config.json konfigurierte Model des Agents (z. B. \"haiku\", \"sonnet\", \"opus\", \"fable\")."
          },
          "permissions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional. Ueberschreibt vollstaendig (kein Merge) die in config.json fuer diesen Agent konfigurierten Default-Permissions. Gleiche Regel-Syntax wie settings.json permissions.allow (z. B. \"Bash(gradle *)\"), wird als --allowedTools an claude uebergeben. Immer additiv zu den permissions.allow/ask/deny-Regeln, die im Zielprojekt selbst (settings.json) gelten - ersetzt oder umgeht diese nie."
          }
        },
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "version"],
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "version": { "type": "string", "description": "Version von cl (aus package.json)." }
        }
      },
      "AuthStatusResponse": {
        "type": "object",
        "required": ["active", "pending"],
        "properties": {
          "active": {
            "type": "boolean",
            "description": "true, wenn ein bestaetigter Google Authenticator aktiv ist."
          },
          "pending": {
            "type": "boolean",
            "description": "true, wenn ein Secret per POST /auth/setup erzeugt, aber noch nicht per POST /auth/setup/confirm bestaetigt wurde."
          }
        }
      },
      "PathList": {
        "type": "object",
        "required": ["paths"],
        "properties": {
          "paths": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Nur die Namen (paths[].name) aus config.json, nicht die Dateisystem-Pfade."
          }
        }
      },
      "HostedList": {
        "type": "object",
        "required": ["hosted"],
        "properties": {
          "hosted": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Nur die Namen (paths[].hosted[].name) eines Pfad-Eintrags aus config.json."
          }
        }
      },
      "FileList": {
        "type": "object",
        "required": ["files"],
        "properties": {
          "files": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Dateinamen, die direkt (nicht rekursiv) im hosted-Verzeichnis liegen, einzeln abrufbar ueber GET /files/{pathName}/{hostedName}/{fileName}."
          }
        }
      },
      "CommandAccepted": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "ID des gestarteten Commands, abfragbar via GET /state/{id}."
          }
        }
      },
      "CommandState": {
        "type": "object",
        "required": [
          "id",
          "agent",
          "model",
          "command",
          "path",
          "status",
          "output",
          "exitCode",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "agent": {
            "type": "string",
            "description": "\"main\" oder der Agent-Name aus config.json."
          },
          "model": { "type": "string" },
          "command": { "type": "string" },
          "path": {
            "type": "string",
            "description": "Der aus config.json (paths[].path) aufgeloeste Dateisystem-Pfad, in dem claude ausgefuehrt wurde (cwd)."
          },
          "status": {
            "type": "string",
            "enum": ["running", "completed", "failed"]
          },
          "output": {
            "type": "string",
            "description": "Kompletter bisheriger stdout/stderr-Output, live aktualisiert waehrend \"running\"."
          },
          "exitCode": {
            "type": ["integer", "null"],
            "description": "Exit-Code des claude-Prozesses; null solange \"running\" oder bei Spawn-Fehler."
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "MessageResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      },
      "AuthSetupResponse": {
        "type": "object",
        "required": ["secret", "otpauthUrl"],
        "properties": {
          "secret": {
            "type": "string",
            "description": "Base32-kodiertes TOTP-Secret, manuell eingebbar in Google Authenticator."
          },
          "otpauthUrl": {
            "type": "string",
            "description": "otpauth://totp/... URI, als QR-Code darstellbar fuer den Scan-Import in Google Authenticator."
          }
        }
      },
      "AuthSetupConfirmRequest": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "description": "Aktueller 6-stelliger Code aus Google Authenticator fuer das per POST /auth/setup erzeugte Secret."
          }
        },
        "additionalProperties": false
      },
      "PathCommandEntry": {
        "type": "object",
        "required": ["key", "command", "displayName", "description"],
        "properties": {
          "key": {
            "type": "string",
            "description": "Eindeutiger Bezeichner, Teil der URL (POST /paths/{pathName}/commands/{key})."
          },
          "command": {
            "type": "string",
            "description": "Der Shell-Befehl, der im Verzeichnis des Pfad-Eintrags ausgefuehrt wird."
          },
          "displayName": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "PathCommandList": {
        "type": "object",
        "required": ["commands"],
        "properties": {
          "commands": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PathCommandEntry" }
          }
        }
      },
      "ManifestAgent": {
        "type": "object",
        "required": ["command", "description"],
        "properties": {
          "command": {
            "type": "string",
            "description": "Aufrufbarer CLI-Befehl, z. B. \"cl\" (main-Agent) oder \"cl dev\"."
          },
          "description": { "type": "string" }
        }
      },
      "ManifestHostedEntry": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["path", "file"] }
        }
      },
      "ManifestPath": {
        "type": "object",
        "required": ["name", "commands", "hosted"],
        "properties": {
          "name": { "type": "string" },
          "commands": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PathCommandEntry" }
          },
          "hosted": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ManifestHostedEntry" }
          }
        }
      },
      "Manifest": {
        "type": "object",
        "required": ["agents", "paths"],
        "properties": {
          "agents": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ManifestAgent" }
          },
          "paths": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ManifestPath" }
          }
        }
      },
      "TicketStatus": {
        "type": "string",
        "enum": ["open", "in progress", "done", "rejected"]
      },
      "Ticket": {
        "type": "object",
        "required": [
          "id",
          "pathName",
          "originalRequest",
          "summary",
          "claudeInstruction",
          "category",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Fortlaufende, ueber alle Pfade hinweg eindeutige ID."
          },
          "pathName": {
            "type": "string",
            "description": "Name des Pfads (paths[].name), zu dem dieses Ticket gehoert. Nicht editierbar."
          },
          "originalRequest": {
            "type": "string",
            "description": "Die urspruengliche, unveraenderte Anweisung des Users (\"text\" aus POST /tickets/:pathName)."
          },
          "summary": {
            "type": "string",
            "description": "Kurze Beschreibung des Ziels und des aktuellen Ist-Zustands."
          },
          "claudeInstruction": {
            "type": "string",
            "description": "Konkrete Anweisung, wie man sie Claude spaeter geben wuerde, um das Feature/den Fix umzusetzen."
          },
          "category": {
            "type": "string",
            "description": "Schlagwort zur Gruppierung zusammenhaengender Tickets."
          },
          "status": { "$ref": "#/components/schemas/TicketStatus" },
          "ipAddress": {
            "type": ["string", "null"],
            "description": "IP-Adresse des Clients, der das Ticket per POST /tickets/:pathName angelegt hat. Wird beim Anlegen gesetzt, nicht editierbar (wie id/pathName). Null bei Tickets aus der Zeit vor diesem Feld."
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TicketList": {
        "type": "object",
        "required": ["tickets"],
        "properties": {
          "tickets": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Ticket" }
          }
        }
      },
      "TicketCreateRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Kurzer, ggf. unklarer Text (z. B. \"ein neues Modul, das xyz kann\"), den der Ticket-Agent im Projektkontext interpretiert."
          }
        },
        "additionalProperties": false
      },
      "TicketUpdateRequest": {
        "type": "object",
        "description": "Mindestens eines der Felder muss angegeben werden. \"pathName\" und \"id\" sind nicht editierbar.",
        "properties": {
          "originalRequest": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "claudeInstruction": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/components/schemas/TicketStatus" }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "TotpAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-TOTP-Code",
        "description": "Aktueller 6-stelliger Code aus dem eingerichteten Google Authenticator. Nicht erforderlich fuer POST /auth/setup und POST /auth/setup/confirm."
      }
    }
  }
}
